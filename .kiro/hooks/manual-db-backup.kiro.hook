{
  "enabled": true,
  "name": "Manual DB Backup",
  "description": "Run this manually anytime to backup all database data to JSON files",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "cd /d \"c:\\Users\\Lenovo\\Downloads\\nbscgco\" && node scripts\\backup-data.mjs && node scripts\\backup-submissions.mjs",
    "timeout": 300
  }
}