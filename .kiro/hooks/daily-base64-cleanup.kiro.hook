{
  "enabled": true,
  "name": "Daily Base64 Cleanup",
  "description": "Runs the base64 cleanup script automatically when Kiro starts up to keep the database clean",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "runCommand",
    "command": "cd /d \"c:\\Users\\Lenovo\\Downloads\\nbscgco\" && node scripts\\clear-base64.mjs"
  },
  "workspaceFolderName": "nbscgco",
  "shortName": "daily-base64-cleanup"
}